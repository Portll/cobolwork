{
 "schemaVersion": 1,
 "retrieved": "2026-09-24",
 "note": "Every publicly named z vulnerability this project could find, and what a rule over a repository could see of each. The advisories were swept from NVD by diag/sweep-z.mjs; the techniques are from published mainframe security research that never became a CVE. A row is classified by what a customer artefact would show, not by what a patch would fix: covered means a rule in this tool already reports the sibling, new names the rule that would, none means the defect leaves nothing in a repository to see. Each proposed rule carries builtAs, the rule ids that shipped for it. A row carries reportedBy, the rule ids that report a sibling of that row - which is not the same thing, because a design can ship a rule that reaches some of its rows and not others. A row a new rule would report but none does carries whyNotReported: extension where an existing rule reaches it with a known change, estate-fact where only the estate can supply what decides it, and no-sibling where the measurement found no customer artefact at all - which means the original verdict of new was optimistic for that row. diag/check-worklist.mjs counts reportedBy, and test/z-worklist.test.mjs checks every id in both against the engine so neither link can rot.",
 "sources": {
  "nvd": "https://services.nvd.nist.gov/rest/json/cves/2.0",
  "cpe": [
   "cpe:2.3:o:ibm:z\\/os",
   "cpe:2.3:a:ibm:cics_transaction_server",
   "cpe:2.3:a:ibm:ims",
   "cpe:2.3:a:ibm:tivoli_netview",
   "cpe:2.3:a:ibm:rational_developer_for_system_z"
  ],
  "keyword": [
   "CICS",
   "RACF",
   "JES2",
   "IMS Transaction Manager",
   "z/OS",
   "ACF2",
   "TN3270",
   "COBOL"
  ]
 },
 "proposedRules": {
  "N-BMS": {
   "what": "A BMS map marks a field protected, dark or numeric, and the program trusts the value that comes back",
   "builtAs": [
    "cics-protected-field-to-record-key",
    "cics-protected-field-to-record-update"
   ]
  },
  "N-PRIV": {
   "what": "A transaction, job or library runs at a privilege nothing in the repository says it needs",
   "builtAs": [
    "csd-defines-diagnostic-transaction",
    "csd-transaction-without-command-security",
    "job-runs-under-another-user",
    "job-unloads-the-security-database",
    "job-loads-from-an-authorised-library",
    "job-writes-diagnostic-output-unrestricted",
    "job-reaches-unix-system-services"
   ]
  },
  "N-IDENTITY": {
   "what": "A program takes the identity it authorises against from the request rather than from the system",
   "builtAs": [
    "cics-signon-bypassed"
   ]
  },
  "N-LOG": {
   "what": "A field the credential pack recognises, or unescaped input, reaches a log, trace or error response",
   "builtAs": [
    "log-writes-a-credential",
    "log-writes-personal-data",
    "cics-terminal-to-log",
    "cics-web-to-log",
    "system-response-to-web-response",
    "system-response-to-http-header",
    "job-writes-diagnostic-output-unrestricted"
   ]
  },
  "N-RECVLIMIT": {
   "what": "Input is received or storage acquired with no length the program chose",
   "builtAs": []
  },
  "N-CRYPTO": {
   "what": "A connection or a cipher is requested at a strength the estate would not accept if asked",
   "builtAs": [
    "cics-listener-accepts-cleartext"
   ]
  },
  "N-XXE": {
   "what": "A document from outside is parsed as XML with entity and expansion handling left to the default",
   "builtAs": []
  },
  "N-COOKIE": {
   "what": "A cookie or a URI carries a credential without the attributes that keep it off the wire",
   "builtAs": [
    "web-cookie-without-secure-attributes",
    "web-uri-carries-a-credential"
   ]
  },
  "N-CSRF": {
   "what": "A request from the web changes state without the program comparing anything the browser could not forge",
   "builtAs": [
    "web-request-changes-state-without-a-token"
   ]
  },
  "N-HEADERS": {
   "what": "An HTML response goes out without the headers that decide who may frame, script or link to it",
   "builtAs": [
    "web-response-without-protective-headers",
    "web-link-opens-without-noopener",
    "web-response-tells-the-caller-what-it-runs"
   ]
  },
  "N-ORACLE": {
   "what": "Two failure paths answer differently, so the answer tells the caller which one it took",
   "builtAs": [
    "cics-signon-says-which-half-failed"
   ]
  },
  "N-CONNSTR": {
   "what": "A connection string or URL is built from a field that came from outside",
   "builtAs": []
  }
