 /* Terminal input names the module the program fetches and calls. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL 1 INAREA,
       2 MODNAME CHAR(8),
       2 FILLER CHAR(2);
   DCL INLEN FIXED BIN(15) INIT(10);
   DCL MODNAME2 CHAR(8);
   DCL MOD ENTRY;

   EXEC CICS RECEIVE INTO(INAREA) LENGTH(INLEN);
   MODNAME2 = INAREA.MODNAME;
   FETCH MOD TITLE(MODNAME2);
   CALL MOD;
   EXEC CICS RETURN;
 END MAIN;
