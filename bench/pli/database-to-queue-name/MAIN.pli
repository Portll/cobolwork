 /* A queue name read from Db2 names the TS queue the program writes
    to. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL DEPT CHAR(4) INIT('D100');
   DCL QNAME CHAR(8);
   DCL MSG CHAR(80) INIT('ORDER RECEIVED');
   EXEC SQL INCLUDE SQLCA;

   EXEC SQL SELECT WORK_QUEUE INTO :QNAME
            FROM DEPARTMENTS WHERE DEPT_ID = :DEPT;
   IF SQLCODE ^= 0 THEN DO;
     EXEC CICS RETURN;
   END;
   EXEC CICS WRITEQ TS QUEUE(QNAME) FROM(MSG);
   EXEC CICS RETURN;
 END MAIN;
