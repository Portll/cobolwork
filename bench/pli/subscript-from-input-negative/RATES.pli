RATES: PROCEDURE OPTIONS(MAIN);

 DCL RATES(12) FIXED DEC(7,4);
 DCL MONTH FIXED BIN(31);

 EXEC CICS RECEIVE
  INTO(MONTH)
  MAP('MONTHMAP')
  ENDRECEIVE;

 IF MONTH < 1 | MONTH > 12 THEN
  RETURN;

 RATES(MONTH) = 0.05;

 EXEC CICS SEND
  FROM(RATES(MONTH))
  MAP('MONTHMAP')
  ENDSEND;

 RETURN;

END RATES;
