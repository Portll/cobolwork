 /* The job step's PARM only switches tracing; the heap storage size is
    a constant. */
 MAIN: PROCEDURE (PARM) OPTIONS(MAIN);
   %INCLUDE CEEIBMAW;
   DCL PARM CHAR(100) VARYING;
   DCL HEAPID FIXED BIN(31) INIT(0);
   DCL STGSIZE FIXED BIN(31) INIT(65536);
   DCL BUFPTR POINTER;
   DCL FC CHAR(12);

   IF PARM = 'TRACE' THEN PUT SKIP LIST('TRACE ON');
   CALL CEEGTST(HEAPID, STGSIZE, BUFPTR, FC);
   CALL CEEFRST(BUFPTR, FC);
 END MAIN;
