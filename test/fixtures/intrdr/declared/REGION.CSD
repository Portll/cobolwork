* The application's resource definitions, as DFHCSDUP reads them.
 DEFINE TDQUEUE(JOBS) GROUP(APP)
        DESCRIPTION(SUBMIT JOBS FROM CICS)
        TYPE(EXTRA) DDNAME(INREADER)
 DEFINE TDQUEUE(LOGQ) GROUP(APP)
        TYPE(EXTRA) DDNAME(APPLOG)
 DEFINE TRANSACTION(JSUB) GROUP(APP) PROGRAM(JOBSUB)
