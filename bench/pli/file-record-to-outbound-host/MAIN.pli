 /* A host name read from a partner file is the host the program opens
    an HTTP session to. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL 1 PARTNER,
       2 PARTID CHAR(8),
       2 HOSTNAME CHAR(64),
       2 FILLER CHAR(8);
   DCL KEY CHAR(8) INIT('BANK01');
   DCL HOST CHAR(64);
   DCL HOSTLEN FIXED BIN(31);
   DCL SESSTOK CHAR(8);
   DCL REPLY CHAR(512);
   DCL REPLYLEN FIXED BIN(31);

   EXEC CICS READ FILE('PARTNERS') INTO(PARTNER) RIDFLD(KEY);
   HOST = PARTNER.HOSTNAME;
   HOSTLEN = LENGTH(TRIM(HOST));
   EXEC CICS WEB OPEN HOST(HOST) HOSTLENGTH(HOSTLEN)
             SCHEME(DFHVALUE(HTTPS)) SESSTOKEN(SESSTOK);
   EXEC CICS WEB CONVERSE SESSTOKEN(SESSTOK) PATH('/rates')
             PATHLENGTH(6) METHOD(DFHVALUE(GET)) INTO(REPLY)
             TOLENGTH(REPLYLEN);
   EXEC CICS WEB CLOSE SESSTOKEN(SESSTOK);
   EXEC CICS RETURN;
 END MAIN;
