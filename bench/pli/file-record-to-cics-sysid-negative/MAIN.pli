 /* The LINK is shipped to a fixed SYSID; the routing record only
    fills the COMMAREA. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL 1 ROUTEREC,
       2 ROUTEKEY CHAR(8),
       2 REGION CHAR(4),
       2 FILLER CHAR(68);
   DCL KEY CHAR(8) INIT('ACCTINQ');
   DCL CA CHAR(100);

   EXEC CICS READ FILE('ROUTES') INTO(ROUTEREC) RIDFLD(KEY);
   CA = ROUTEREC.REGION;
   EXEC CICS LINK PROGRAM('ACCTINQ') COMMAREA(CA) SYSID('CICB');
   EXEC CICS RETURN;
 END MAIN;
