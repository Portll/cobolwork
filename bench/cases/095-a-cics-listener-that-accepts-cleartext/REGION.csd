* A region's listeners, as DFHCSDUP lists them.
DEFINE TCPIPSERVICE(ZOSEE) GROUP(BANK)
       PORTNUMBER(30709) PROTOCOL(IPIC) SSL(NO)
       TRANSACTION(CISS)
DEFINE TCPIPSERVICE(PLAINWEB) GROUP(BANK)
       PORTNUMBER(4321) PROTOCOL(HTTP)
       TRANSACTION(CWXN)
DEFINE TCPIPSERVICE(SECUREWEB) GROUP(BANK)
       PORTNUMBER(4322) PROTOCOL(HTTP) SSL(YES)
       CERTIFICATE(BANKCERT) TRANSACTION(CWXN)
DEFINE TCPIPSERVICE(MUTUAL) GROUP(BANK)
       PORTNUMBER(4323) PROTOCOL(HTTP) SSL(CLIENTAUTH)
       TRANSACTION(CWXN)
