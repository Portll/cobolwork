 /* The job step's PARM is the size of the heap storage the program
    gets from CEEGTST. */
 MAIN: PROCEDURE (PARM) OPTIONS(MAIN);
   %INCLUDE CEEIBMAW;
   DCL PARM CHAR(100) VARYING;
   DCL HEAPID FIXED BIN(31) INIT(0);
   DCL STGSIZE FIXED BIN(31);
   DCL BUFPTR POINTER;
   DCL FC CHAR(12);

   STGSIZE = SUBSTR(PARM, 1, MIN(LENGTH(PARM), 9));
   CALL CEEGTST(HEAPID, STGSIZE, BUFPTR, FC);
   CALL CEEFRST(BUFPTR, FC);
 END MAIN;
