 /* A month number in the job's in-stream SYSIN picks the rate table
    entry, unchecked. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL SYSIN FILE RECORD INPUT;
   DCL 1 CARD,
       2 MONTH PIC'99',
       2 FILLER CHAR(78);
   DCL RATES(12) FIXED DEC(7,4) INIT(
       1.25, 1.50, 1.75, 2.00, 2.25, 2.50,
       2.75, 3.00, 3.25, 3.50, 3.75, 4.00);
   DCL IX FIXED BIN(31);
   DCL R FIXED DEC(7,4);

   OPEN FILE(SYSIN);
   READ FILE(SYSIN) INTO(CARD);
   CLOSE FILE(SYSIN);
   IX = CARD.MONTH;
   R = RATES(IX);
   PUT SKIP LIST('RATE', IX, R);
 END MAIN;
