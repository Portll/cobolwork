 /* The job step's PARM only switches tracing; the report file is
    opened under its own name. */
 MAIN: PROCEDURE (PARM) OPTIONS(MAIN);
   DCL PARM CHAR(100) VARYING;
   DCL REPORT FILE RECORD OUTPUT;
   DCL OUTLINE CHAR(80) INIT('DAILY SETTLEMENT REPORT');

   IF PARM = 'TRACE' THEN PUT SKIP LIST('TRACE ON');
   OPEN FILE(REPORT);
   WRITE FILE(REPORT) FROM(OUTLINE);
   CLOSE FILE(REPORT);
 END MAIN;
