 /* The sign-on screen's password goes to the security manager through CICS VERIFY. */
 SIGNON: PROCEDURE OPTIONS(MAIN);
   DCL 1 SCREEN,
       2 USERID CHAR(8),
       2 PASSWORD CHAR(8);
   DCL INLEN FIXED BIN(15) INIT(16);
   DCL RESP FIXED BIN(31);
   DCL MSG CHAR(20);

   EXEC CICS RECEIVE INTO(SCREEN) LENGTH(INLEN);
   EXEC CICS VERIFY PASSWORD(PASSWORD) USERID(USERID) RESP(RESP);
   IF RESP = DFHRESP(NORMAL) THEN MSG = 'ACCESS GRANTED';
   ELSE MSG = 'ACCESS DENIED';
   EXEC CICS SEND TEXT FROM(MSG) ERASE;
   EXEC CICS RETURN;
 END SIGNON;
