 /* A web request names the CICS file the record is written to. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL 1 FORM,
       2 FILENAME CHAR(8),
       2 RECKEY CHAR(10),
       2 DATA CHAR(80);
   DCL FORMLEN FIXED BIN(31) INIT(98);
   DCL FNAME CHAR(8);
   DCL KEY CHAR(10);

   EXEC CICS WEB RECEIVE INTO(FORM) LENGTH(FORMLEN);
   FNAME = FORM.FILENAME;
   KEY = FORM.RECKEY;
   EXEC CICS WRITE FILE(FNAME) FROM(FORM.DATA) RIDFLD(KEY);
   EXEC CICS RETURN;
 END MAIN;
