 /* The PARM only switches tracing; the program linked to is fixed. */
 MAIN: PROCEDURE (PARM) OPTIONS(MAIN);
   DCL PARM CHAR(100) VARYING;
   DCL PGMNAME CHAR(8) INIT('ACCTMAIN');
   DCL CA CHAR(256);
   DCL 1 EXCI_RC,
       2 RESPONSE FIXED BIN(31),
       2 REASON FIXED BIN(31),
       2 SUBREASON1 FIXED BIN(31),
       2 SUBREASON2 FIXED BIN(31),
       2 MSGPTR POINTER;

   IF PARM = 'TRACE' THEN PUT SKIP LIST('TRACE ON');
   CA = 'INITIAL DATA';
   EXEC CICS LINK PROGRAM(PGMNAME) APPLID('CICSPROD') COMMAREA(CA)
             LENGTH(256) RETCODE(EXCI_RC) SYNCONRETURN;
   IF EXCI_RC.RESPONSE ^= 0 THEN PUT SKIP LIST('LINK FAILED',
       EXCI_RC.RESPONSE);
 END MAIN;
