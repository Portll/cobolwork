 /* The terminal's length is only compared; GETMAIN and LINK use a
    constant. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL 1 TERMAREA,
       2 TERM_LEN FIXED BIN(31),
       2 TERM_DATA CHAR(256);
   DCL P POINTER;
   DCL COMM CHAR(1024) BASED(P);
   DCL MAX_LEN FIXED BIN(31) VALUE(1024);
   DCL RESP FIXED BIN(31);
   DCL SUBPGM CHAR(8) INIT('SUBPGM');

   EXEC CICS RECEIVE MAP('INMAP') INTO(TERMAREA) RESP(RESP);
   IF TERM_LEN > MAX_LEN THEN RETURN;
   EXEC CICS GETMAIN SET(P) FLENGTH(MAX_LEN) RESP(RESP);
   EXEC CICS LINK PROGRAM(SUBPGM) COMMAREA(COMM) LENGTH(MAX_LEN)
       RESP(RESP);
   EXEC CICS FREEMAIN DATAPOINTER(P);
 END MAIN;
