 /* A region id read from a routing file is the SYSID the LINK is
    shipped to. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL 1 ROUTEREC,
       2 ROUTEKEY CHAR(8),
       2 REGION CHAR(4),
       2 FILLER CHAR(68);
   DCL KEY CHAR(8) INIT('ACCTINQ');
   DCL REMOTE CHAR(4);
   DCL CA CHAR(100);

   EXEC CICS READ FILE('ROUTES') INTO(ROUTEREC) RIDFLD(KEY);
   REMOTE = ROUTEREC.REGION;
   CA = 'BALANCE INQUIRY';
   EXEC CICS LINK PROGRAM('ACCTINQ') COMMAREA(CA) SYSID(REMOTE);
   EXEC CICS RETURN;
 END MAIN;
