 /* The CICS program linked to is fixed; the in-stream SYSIN card is
    only the data passed in the COMMAREA. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL SYSIN FILE RECORD INPUT;
   DCL CARD CHAR(80);
   DCL CA CHAR(256);
   DCL 1 EXCI_RC,
       2 RESPONSE FIXED BIN(31),
       2 REASON FIXED BIN(31),
       2 SUBREASON1 FIXED BIN(31),
       2 SUBREASON2 FIXED BIN(31),
       2 MSGPTR POINTER;

   OPEN FILE(SYSIN);
   READ FILE(SYSIN) INTO(CARD);
   CLOSE FILE(SYSIN);
   CA = CARD;
   EXEC CICS LINK PROGRAM('ACCTUPD') APPLID('CICSPROD') COMMAREA(CA)
             LENGTH(256) RETCODE(EXCI_RC) SYNCONRETURN;
   IF EXCI_RC.RESPONSE ^= 0 THEN PUT SKIP LIST('LINK FAILED',
       EXCI_RC.RESPONSE);
 END MAIN;
