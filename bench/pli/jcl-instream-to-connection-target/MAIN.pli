 /* A location name in the job's in-stream SYSIN is the Db2 location
    the program connects to. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL SYSIN FILE RECORD INPUT;
   DCL 1 CARD,
       2 LOCNAME CHAR(16),
       2 FILLER CHAR(64);
   DCL LOCN CHAR(16);
   DCL SQLID CHAR(8);
   EXEC SQL INCLUDE SQLCA;

   OPEN FILE(SYSIN);
   READ FILE(SYSIN) INTO(CARD);
   CLOSE FILE(SYSIN);
   LOCN = CARD.LOCNAME;
   EXEC SQL CONNECT TO :LOCN;
   IF SQLCODE ^= 0 THEN RETURN;
   EXEC SQL SET :SQLID = CURRENT SQLID;
   PUT SKIP LIST('CONNECTED AS', SQLID);
 END MAIN;
