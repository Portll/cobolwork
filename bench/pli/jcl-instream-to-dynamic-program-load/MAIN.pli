 /* A module name in the job's in-stream SYSIN is fetched and called. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL SYSIN FILE RECORD INPUT;
   DCL 1 CARD,
       2 MODNAME CHAR(8),
       2 FILLER CHAR(72);
   DCL EXITNAME CHAR(8);
   DCL USEREXIT ENTRY;

   OPEN FILE(SYSIN);
   READ FILE(SYSIN) INTO(CARD);
   CLOSE FILE(SYSIN);
   EXITNAME = CARD.MODNAME;
   FETCH USEREXIT TITLE(EXITNAME);
   CALL USEREXIT;
 END MAIN;
