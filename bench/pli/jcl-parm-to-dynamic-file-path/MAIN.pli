 /* The job step's PARM names the file the program writes its report
    to. */
 MAIN: PROCEDURE (PARM) OPTIONS(MAIN);
   DCL PARM CHAR(100) VARYING;
   DCL REPORT FILE RECORD OUTPUT;
   DCL OUTDD CHAR(8);
   DCL OUTLINE CHAR(80) INIT('DAILY SETTLEMENT REPORT');

   OUTDD = SUBSTR(PARM, 1, MIN(LENGTH(PARM), 8));
   OPEN FILE(REPORT) TITLE(OUTDD);
   WRITE FILE(REPORT) FROM(OUTLINE);
   CLOSE FILE(REPORT);
 END MAIN;
