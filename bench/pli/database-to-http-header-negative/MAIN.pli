 /* The header carries a fixed value; the name read from Db2 goes only
    in the plain-text body. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL CUSTID CHAR(10) INIT('C000000001');
   DCL CUSTNAME CHAR(40);
   DCL HDRNAME CHAR(13) INIT('Cache-Control');
   DCL HDRVAL CHAR(8) INIT('no-store');
   EXEC SQL INCLUDE SQLCA;

   EXEC SQL SELECT CUST_NAME INTO :CUSTNAME
            FROM CUSTOMERS WHERE CUST_ID = :CUSTID;
   IF SQLCODE ^= 0 THEN DO;
     EXEC CICS RETURN;
   END;
   EXEC CICS WEB WRITE HTTPHEADER(HDRNAME) NAMELENGTH(13)
             VALUE(HDRVAL) VALUELENGTH(8);
   EXEC CICS WEB SEND FROM(CUSTNAME) FROMLENGTH(40)
             MEDIATYPE('text/plain');
   EXEC CICS RETURN;
 END MAIN;
