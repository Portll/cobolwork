 /* A web request's body names the module the program fetches and
    calls. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL 1 BODY,
       2 MODNAME CHAR(8);
   DCL BLEN FIXED BIN(31);
   DCL MODNAME2 CHAR(8);
   DCL MOD ENTRY;
   DCL MSG CHAR(14) INIT('PROGRAM LOADED');

   EXEC CICS WEB RECEIVE INTO(BODY) LENGTH(BLEN) MAXLENGTH(8);
   MODNAME2 = BODY.MODNAME;
   FETCH MOD TITLE(MODNAME2);
   CALL MOD;
   EXEC CICS WEB SEND FROM(MSG) FROMLENGTH(14) MEDIATYPE('text/plain');
   EXEC CICS RETURN;
 END MAIN;
