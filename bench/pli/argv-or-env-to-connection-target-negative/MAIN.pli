 /* The PARM only switches tracing; the Db2 location is fixed. */
 MAIN: PROCEDURE (PARM) OPTIONS(MAIN);
   DCL PARM CHAR(100) VARYING;
   DCL LOCN CHAR(16) INIT('DB2PROD');
   DCL SQLID CHAR(8);
   EXEC SQL INCLUDE SQLCA;

   IF PARM = 'TRACE' THEN PUT SKIP LIST('TRACE ON');
   EXEC SQL CONNECT TO :LOCN;
   IF SQLCODE ^= 0 THEN RETURN;
   EXEC SQL SET :SQLID = CURRENT SQLID;
   PUT SKIP LIST('CONNECTED AS', SQLID);
 END MAIN;
