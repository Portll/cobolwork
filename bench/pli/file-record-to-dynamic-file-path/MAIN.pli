 /* A control record names the file the job writes its report to. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL CTLIN FILE RECORD INPUT;
   DCL REPORT FILE RECORD OUTPUT;
   DCL 1 CTLREC,
       2 OUTNAME CHAR(8),
       2 FILLER CHAR(72);
   DCL OUTDD CHAR(8);
   DCL OUTLINE CHAR(80) INIT('DAILY SETTLEMENT REPORT');

   OPEN FILE(CTLIN);
   READ FILE(CTLIN) INTO(CTLREC);
   CLOSE FILE(CTLIN);
   OUTDD = CTLREC.OUTNAME;
   OPEN FILE(REPORT) TITLE(OUTDD);
   WRITE FILE(REPORT) FROM(OUTLINE);
   CLOSE FILE(REPORT);
 END MAIN;
