 RDREC: PROCEDURE OPTIONS(MAIN);
   DCL INF FILE RECORD INPUT;
   DCL EOF BIT(1) INIT('0'B);
   DCL 1 REC,
         2 ENTRY_OFFSET FIXED BIN(31),
         2 PAYLOAD CHAR(200);
   DCL P POINTER;
   DCL 1 ENTRY_VIEW BASED(P),
         2 ACCT_NO CHAR(10),
         2 AMOUNT FIXED DEC(11,2);
   DCL TOTAL FIXED DEC(15,2) INIT(0);
   ON ENDFILE(INF) EOF = '1'B;
   OPEN FILE(INF) INPUT;
   READ FILE(INF) INTO(REC);
   DO WHILE (¬EOF);
     /* The record says where its entry starts; nothing checks it lies inside PAYLOAD. */
     P = POINTERADD(ADDR(PAYLOAD), ENTRY_OFFSET);
     TOTAL = TOTAL + AMOUNT;
     READ FILE(INF) INTO(REC);
   END;
   CLOSE FILE(INF);
   PUT SKIP LIST('TOTAL', TOTAL);
 END RDREC;
