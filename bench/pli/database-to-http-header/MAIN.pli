 /* A customer name read from Db2 is written into a header of the
    web response. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL CUSTID CHAR(10) INIT('C000000001');
   DCL CUSTNAME CHAR(40);
   DCL HDRNAME CHAR(10) INIT('X-Customer');
   DCL BODY CHAR(2) INIT('OK');
   EXEC SQL INCLUDE SQLCA;

   EXEC SQL SELECT CUST_NAME INTO :CUSTNAME
            FROM CUSTOMERS WHERE CUST_ID = :CUSTID;
   IF SQLCODE ^= 0 THEN DO;
     EXEC CICS RETURN;
   END;
   EXEC CICS WEB WRITE HTTPHEADER(HDRNAME) NAMELENGTH(10)
             VALUE(CUSTNAME) VALUELENGTH(40);
   EXEC CICS WEB SEND FROM(BODY) FROMLENGTH(2)
             MEDIATYPE('text/plain');
   EXEC CICS RETURN;
 END MAIN;
