//NIGHTXFR JOB (ACCT),'SEND TO BUREAU',CLASS=A,MSGCLASS=X
//*
//* SEND THE NIGHTLY STATEMENT FILE TO THE PRINT BUREAU
//*
//SEND     EXEC PGM=FTP,
//             PARM='-r TLS BUREAU.EXAMPLE.COM (EXIT'
//OUTPUT   DD SYSOUT=*
//INPUT    DD *
STMTXFR BUR3AU99
BINARY
PUT 'STMT.NIGHTLY.PRINT' stmt.dat
QUIT
/*
