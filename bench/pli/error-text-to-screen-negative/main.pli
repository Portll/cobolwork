 /* The terminal gets a fixed message chosen by SQLCODE, never Db2's own text. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL MSG_LINE CHAR(80);
   EXEC SQL INCLUDE SQLCA;

   EXEC SQL DECLARE C1 CURSOR FOR
            SELECT EMP_ID, EMP_NAME FROM EMPLOYEES WHERE DEPT_ID = 10;
   EXEC SQL OPEN C1;
   IF SQLCODE ^= 0 THEN DO;
     SELECT (SQLCODE);
       WHEN (-204) MSG_LINE = 'TABLE NOT FOUND';
       WHEN (-803) MSG_LINE = 'DUPLICATE KEY';
       OTHERWISE MSG_LINE = 'DATABASE ERROR';
     END;
     EXEC CICS SEND TEXT FROM(MSG_LINE) ERASE;
   END;
   EXEC SQL CLOSE C1;
 END MAIN;
