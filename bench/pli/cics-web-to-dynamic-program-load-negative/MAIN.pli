 /* The request body only ends the transaction; the module is named in
    the FETCH itself. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL 1 BODY,
       2 MODNAME CHAR(8);
   DCL BLEN FIXED BIN(31);
   DCL FIXEDMOD ENTRY;
   DCL MSG CHAR(14) INIT('PROGRAM LOADED');

   EXEC CICS WEB RECEIVE INTO(BODY) LENGTH(BLEN) MAXLENGTH(8);
   IF BODY.MODNAME = 'END' THEN DO;
     EXEC CICS RETURN;
   END;
   FETCH FIXEDMOD;
   CALL FIXEDMOD;
   EXEC CICS WEB SEND FROM(MSG) FROMLENGTH(14) MEDIATYPE('text/plain');
   EXEC CICS RETURN;
 END MAIN;
