 DCL PLITDLI ENTRY;
 DCL GHU_FUNC FIXED BIN(31) VALUE INIT(1);
 DCL DLET_FUNC FIXED BIN(31) VALUE INIT(2);
 DCL DB_PCB POINTER;
 DCL IO_AREA POINTER;
 DCL SSA1 POINTER;
 DCL THREE FIXED BIN(31) VALUE INIT(3);
 DCL TWO_ARGS FIXED BIN(31) VALUE INIT(2);
 DCL STATUS FIXED BIN(31);

 MAIN: PROCEDURE OPTIONS(MAIN);

  CALL PLITDLI(THREE, GHU_FUNC, DB_PCB, IO_AREA, SSA1);
  DO WHILE (STATUS = 0);
   CALL PLITDLI(TWO_ARGS, DLET_FUNC, DB_PCB, IO_AREA);
  END;

  RETURN;
 END MAIN;
