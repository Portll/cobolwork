 /* A control record names the module the job fetches and calls. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL CTLIN FILE RECORD INPUT;
   DCL 1 CTLREC,
       2 MODNAME CHAR(8),
       2 FILLER CHAR(72);
   DCL EXITNAME CHAR(8);
   DCL USEREXIT ENTRY;

   OPEN FILE(CTLIN);
   READ FILE(CTLIN) INTO(CTLREC);
   CLOSE FILE(CTLIN);
   EXITNAME = CTLREC.MODNAME;
   FETCH USEREXIT TITLE(EXITNAME);
   CALL USEREXIT;
 END MAIN;
