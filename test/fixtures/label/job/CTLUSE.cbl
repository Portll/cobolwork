       IDENTIFICATION DIVISION.
       PROGRAM-ID. CTLUSE.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CTL-FILE ASSIGN TO CTLIN FILE STATUS IS WS-CTL-ST.
           SELECT HIST-FILE ASSIGN TO HISTIN FILE STATUS IS WS-HST-ST.
           SELECT REF-FILE ASSIGN TO REFIN
               ORGANIZATION IS INDEXED ACCESS MODE IS RANDOM
               RECORD KEY IS REF-KEY FILE STATUS IS WS-REF-ST.
           SELECT PARM-FILE ASSIGN TO PARMIN.
       DATA DIVISION.
       FILE SECTION.
       FD CTL-FILE RECORD CONTAINS 80 CHARACTERS.
       01 CTL-REC.
          05 CTL-COUNT PIC 9(5).
          05 FILLER PIC X(75).
       FD HIST-FILE RECORD CONTAINS 80 CHARACTERS.
       01 HIST-REC PIC X(80).
       FD REF-FILE RECORD CONTAINS 40 CHARACTERS.
       01 REF-REC.
          05 REF-KEY PIC X(8).
          05 FILLER PIC X(32).
       FD PARM-FILE RECORD CONTAINS 80 CHARACTERS.
       01 PARM-REC PIC X(80).
       WORKING-STORAGE SECTION.
       01 WS-CTL-ST PIC XX.
       01 WS-HST-ST PIC XX.
       01 WS-REF-ST PIC XX.
       01 WS-PARM.
          05 WS-PGM PIC X(8).
          05 WS-QTY PIC 9(5).
          05 FILLER PIC X(67).
       01 WS-TOTAL PIC 9(9) VALUE 0.
       PROCEDURE DIVISION.
           OPEN INPUT CTL-FILE HIST-FILE REF-FILE
           IF WS-CTL-ST NOT = '00' OR WS-HST-ST NOT = '00'
                   OR WS-REF-ST NOT = '00'
               DISPLAY 'CTLUSE: AN INPUT DID NOT OPEN'
               MOVE 16 TO RETURN-CODE
               GOBACK
           END-IF
           READ CTL-FILE
           OPEN INPUT PARM-FILE
           READ PARM-FILE INTO WS-PARM
           COMPUTE WS-TOTAL = WS-QTY * CTL-COUNT
           CALL WS-PGM ON EXCEPTION CONTINUE END-CALL
           CLOSE CTL-FILE HIST-FILE REF-FILE PARM-FILE
           GOBACK.
