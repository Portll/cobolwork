 /* A start position in the job's in-stream SYSIN decides where SUBSTR
    reads, unchecked. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL SYSIN FILE RECORD INPUT;
   DCL 1 CARD,
       2 STARTPOS PIC'999',
       2 FILLER CHAR(77);
   DCL HEADER CHAR(40) INIT('ACCOUNT STATEMENT FOR PERIOD 2026-09');
   DCL START FIXED BIN(31);
   DCL PART CHAR(10);

   OPEN FILE(SYSIN);
   READ FILE(SYSIN) INTO(CARD);
   CLOSE FILE(SYSIN);
   START = CARD.STARTPOS;
   PART = SUBSTR(HEADER, START, 10);
   PUT SKIP LIST('FIELD', PART);
 END MAIN;
