 /* The module fetched is the entry constant itself; the in-stream
    SYSIN card is only passed to it. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL SYSIN FILE RECORD INPUT;
   DCL CARD CHAR(80);
   DCL USEREXIT ENTRY(CHAR(80));

   OPEN FILE(SYSIN);
   READ FILE(SYSIN) INTO(CARD);
   CLOSE FILE(SYSIN);
   FETCH USEREXIT;
   CALL USEREXIT(CARD);
 END MAIN;
