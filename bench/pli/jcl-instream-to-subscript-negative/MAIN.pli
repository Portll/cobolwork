 /* The in-stream SYSIN card only switches tracing; the rate table
    entry is fixed. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL SYSIN FILE RECORD INPUT;
   DCL 1 CARD,
       2 OPTION CHAR(8),
       2 FILLER CHAR(72);
   DCL RATES(12) FIXED DEC(7,4) INIT(
       1.25, 1.50, 1.75, 2.00, 2.25, 2.50,
       2.75, 3.00, 3.25, 3.50, 3.75, 4.00);
   DCL IX FIXED BIN(31) INIT(9);
   DCL R FIXED DEC(7,4);

   OPEN FILE(SYSIN);
   READ FILE(SYSIN) INTO(CARD);
   CLOSE FILE(SYSIN);
   IF CARD.OPTION = 'TRACE' THEN PUT SKIP LIST('TRACE ON');
   R = RATES(IX);
   PUT SKIP LIST('RATE', IX, R);
 END MAIN;
