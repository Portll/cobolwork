 /* A job step's PARM names the Db2 location the program connects to. */
 MAIN: PROCEDURE (PARM) OPTIONS(MAIN);
   DCL PARM CHAR(100) VARYING;
   DCL LOCN CHAR(16);
   DCL SQLID CHAR(8);
   EXEC SQL INCLUDE SQLCA;

   LOCN = SUBSTR(PARM, 1, MIN(LENGTH(PARM), 16));
   EXEC SQL CONNECT TO :LOCN;
   IF SQLCODE ^= 0 THEN RETURN;
   EXEC SQL SET :SQLID = CURRENT SQLID;
   PUT SKIP LIST('CONNECTED AS', SQLID);
 END MAIN;
