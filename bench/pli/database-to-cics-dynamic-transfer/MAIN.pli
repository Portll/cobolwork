 /* A program name read from a Db2 table is the program CICS links
    to. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL ORDTYPE CHAR(2) INIT('RT');
   DCL PGMNAME CHAR(8);
   DCL CA CHAR(100);
   EXEC SQL INCLUDE SQLCA;

   EXEC SQL SELECT HANDLER_PGM INTO :PGMNAME
            FROM ROUTING WHERE ORDER_TYPE = :ORDTYPE;
   IF SQLCODE ^= 0 THEN DO;
     EXEC CICS RETURN;
   END;
   CA = 'NEW ORDER';
   EXEC CICS LINK PROGRAM(PGMNAME) COMMAREA(CA);
   EXEC CICS RETURN;
 END MAIN;
