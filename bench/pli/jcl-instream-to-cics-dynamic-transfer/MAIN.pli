 /* A program name in the job's in-stream SYSIN is the CICS program the
    batch step links to through EXCI. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL SYSIN FILE RECORD INPUT;
   DCL 1 CARD,
       2 PGMNAME CHAR(8),
       2 FILLER CHAR(72);
   DCL TARGET CHAR(8);
   DCL CA CHAR(256);
   DCL 1 EXCI_RC,
       2 RESPONSE FIXED BIN(31),
       2 REASON FIXED BIN(31),
       2 SUBREASON1 FIXED BIN(31),
       2 SUBREASON2 FIXED BIN(31),
       2 MSGPTR POINTER;

   OPEN FILE(SYSIN);
   READ FILE(SYSIN) INTO(CARD);
   CLOSE FILE(SYSIN);
   TARGET = CARD.PGMNAME;
   CA = 'NIGHTLY UPDATE';
   EXEC CICS LINK PROGRAM(TARGET) APPLID('CICSPROD') COMMAREA(CA)
             LENGTH(256) RETCODE(EXCI_RC) SYNCONRETURN;
   IF EXCI_RC.RESPONSE ^= 0 THEN PUT SKIP LIST('LINK FAILED',
       EXCI_RC.RESPONSE);
 END MAIN;
