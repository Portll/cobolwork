 S1: PROCEDURE OPTIONS(MAIN);
   DCL 1 REC,
       2 TXN_CODE CHAR(4),
       2 PAYLOAD CHAR(76);
   DCL HANDLER ENTRY VARIABLE;
   DCL (A, B, C) ENTRY;

   GET LIST(REC.TXN_CODE, REC.PAYLOAD);

   SELECT (REC.TXN_CODE);
     WHEN ('0001') HANDLER = A;
     WHEN ('0002') HANDLER = B;
     OTHERWISE HANDLER = C;
   END;

   CALL HANDLER(REC);
 END S1;
