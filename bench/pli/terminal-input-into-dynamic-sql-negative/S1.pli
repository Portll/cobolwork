 /* The typed name reaches the prepared statement only as a parameter
    marker's value. */
 NAME: PROCEDURE OPTIONS(MAIN);
   DCL 1 INPUT_AREA,
       2 CUST_NAME CHAR(30);
   DCL LEN FIXED BIN(15) INIT(30);
   DCL SQL_TEXT CHAR(200) VARYING;
   EXEC SQL INCLUDE SQLCA;

   EXEC CICS RECEIVE INTO(INPUT_AREA) LENGTH(LEN);
   SQL_TEXT = 'DELETE FROM CUSTOMERS WHERE NAME = ?';
   EXEC SQL PREPARE STMT FROM :SQL_TEXT;
   IF SQLCODE = 0 THEN EXEC SQL EXECUTE STMT USING :CUST_NAME;
   EXEC CICS RETURN;
 END NAME;
