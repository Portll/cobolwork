 /* A length received from the terminal sizes GETMAIN and the LINK
    COMMAREA. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL 1 TERMAREA,
       2 TERM_LEN FIXED BIN(31),
       2 TERM_DATA CHAR(256);
   DCL P POINTER;
   DCL COMM CHAR(32767) BASED(P);
   DCL REQ_LEN FIXED BIN(31);
   DCL RESP FIXED BIN(31);
   DCL SUBPGM CHAR(8) INIT('SUBPGM');

   EXEC CICS RECEIVE MAP('INMAP') INTO(TERMAREA) RESP(RESP);
   REQ_LEN = TERM_LEN;
   EXEC CICS GETMAIN SET(P) FLENGTH(REQ_LEN) RESP(RESP);
   EXEC CICS LINK PROGRAM(SUBPGM) COMMAREA(COMM) LENGTH(REQ_LEN)
       RESP(RESP);
   EXEC CICS FREEMAIN DATAPOINTER(P);
 END MAIN;
