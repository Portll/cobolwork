 /* The in-stream SYSIN card only switches tracing; the Db2 location
    is fixed. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL SYSIN FILE RECORD INPUT;
   DCL 1 CARD,
       2 OPTION CHAR(8),
       2 FILLER CHAR(72);
   DCL LOCN CHAR(16) INIT('DB2PROD');
   DCL SQLID CHAR(8);
   EXEC SQL INCLUDE SQLCA;

   OPEN FILE(SYSIN);
   READ FILE(SYSIN) INTO(CARD);
   CLOSE FILE(SYSIN);
   IF CARD.OPTION = 'TRACE' THEN PUT SKIP LIST('TRACE ON');
   EXEC SQL CONNECT TO :LOCN;
   IF SQLCODE ^= 0 THEN RETURN;
   EXEC SQL SET :SQLID = CURRENT SQLID;
   PUT SKIP LIST('CONNECTED AS', SQLID);
 END MAIN;
