 NAME: PROCEDURE OPTIONS(MAIN);
 DCL 1 INPUT_AREA,
   2 CUST_NAME CHAR(30);
 DCL 1 SQL_TEXT CHAR(200) VARYING;
 DCL 1 STMT POINTER;
 DCL 1 SQLC INTEGER;
 DCL 1 SQLCODE INTEGER;
 DCL 1 LEN FIXED BIN(31);
 DCL 1 CUST_NAME CHAR(30);

 EXEC CICS RECEIVE INTO(INPUT_AREA) LENGTH(LEN) MAP('CUSTMAP');
 CUST_NAME = INPUT_AREA.CUST_NAME;
 SQL_TEXT = 'SELECT * FROM CUSTOMERS WHERE NAME = ''' || CUST_NAME || '''';
 EXEC SQL PREPARE STMT FROM :SQL_TEXT;
 IF SQLCODE <> 0 THEN DO;
   PUT LIST('SQL PREPARE ERROR');
   RETURN;
 END;
 EXEC SQL EXECUTE STMT;
 IF SQLCODE <> 0 THEN DO;
   PUT LIST('SQL EXECUTE ERROR');
   RETURN;
 END;
 EXEC CICS SEND MAP('CUSTMAP') FROM(INPUT_AREA) CURSOR;
 RETURN;
END NAME;
