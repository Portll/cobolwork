//PAYXFER  JOB (ACCT),'PAYROLL TO PARTNER',CLASS=A,MSGCLASS=X
//*
//* SEND THE PAYROLL EXTRACT TO THE PAYMENTS PARTNER
//*
//XFER     EXEC PGM=FTP,
//             PARM='-r TLS PARTNER.EXAMPLE.COM 21 (EXIT'
//NETRC    DD DSN=SEC.PAYXFER.NETRC,DISP=SHR
//OUTPUT   DD SYSOUT=*
//INPUT    DD *
BINARY
PUT 'PROD.PAYROLL.EXTRACT' payroll.dat
QUIT
