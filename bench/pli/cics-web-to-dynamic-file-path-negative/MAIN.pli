 /* The request names a file, accepted only from a fixed list. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL 1 FORM,
       2 FILENAME CHAR(8),
       2 RECKEY CHAR(10),
       2 DATA CHAR(80);
   DCL FORMLEN FIXED BIN(31) INIT(98);
   DCL FNAME CHAR(8);
   DCL KEY CHAR(10);

   EXEC CICS WEB RECEIVE INTO(FORM) LENGTH(FORMLEN);
   KEY = FORM.RECKEY;
   IF FORM.FILENAME = 'ORDERS' THEN FNAME = 'ORDERS';
   ELSE FNAME = 'RETURNS';
   EXEC CICS WRITE FILE(FNAME) FROM(FORM.DATA) RIDFLD(KEY);
   EXEC CICS RETURN;
 END MAIN;
