 /* A count read from a file's header record bounds a loop over a
    table. */
 SUMIT: PROCEDURE OPTIONS(MAIN);
   DCL INF FILE RECORD INPUT;
   DCL 1 HDR,
       2 COUNT FIXED BIN(31),
       2 NAME CHAR(8);
   DCL ITEMS(100) FIXED BIN(31) INIT((100) 0);
   DCL I FIXED BIN(31);
   DCL TOTAL FIXED BIN(31) INIT(0);

   OPEN FILE(INF);
   READ FILE(INF) INTO(HDR);
   DO I = 1 TO HDR.COUNT;
     TOTAL = TOTAL + ITEMS(I);
   END;
   CLOSE FILE(INF);
   PUT SKIP LIST('TOTAL', TOTAL);
 END SUMIT;
