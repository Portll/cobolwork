 /* A batch job's PARM names the CICS program it links to through EXCI. */
 MAIN: PROCEDURE (PARM) OPTIONS(MAIN);
   DCL PARM CHAR(100) VARYING;
   DCL PGMNAME CHAR(8);
   DCL CA CHAR(256);
   DCL 1 EXCI_RC,
       2 RESPONSE FIXED BIN(31),
       2 REASON FIXED BIN(31),
       2 SUBREASON1 FIXED BIN(31),
       2 SUBREASON2 FIXED BIN(31),
       2 MSGPTR POINTER;

   PGMNAME = SUBSTR(PARM, 1, MIN(LENGTH(PARM), 8));
   CA = 'INITIAL DATA';
   EXEC CICS LINK PROGRAM(PGMNAME) APPLID('CICSPROD') COMMAREA(CA)
             LENGTH(256) RETCODE(EXCI_RC) SYNCONRETURN;
   IF EXCI_RC.RESPONSE ^= 0 THEN PUT SKIP LIST('LINK FAILED', EXCI_RC.RESPONSE);
 END MAIN;
