 /* The partner record only decides whether the request is made; the
    host is a constant. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL 1 PARTNER,
       2 PARTID CHAR(8),
       2 ACTIVE CHAR(1),
       2 FILLER CHAR(71);
   DCL KEY CHAR(8) INIT('BANK01');
   DCL SESSTOK CHAR(8);
   DCL REPLY CHAR(512);
   DCL REPLYLEN FIXED BIN(31);

   EXEC CICS READ FILE('PARTNERS') INTO(PARTNER) RIDFLD(KEY);
   IF PARTNER.ACTIVE ^= 'Y' THEN DO;
     EXEC CICS RETURN;
   END;
   EXEC CICS WEB OPEN HOST('rates.example.com') HOSTLENGTH(17)
             SCHEME(DFHVALUE(HTTPS)) SESSTOKEN(SESSTOK);
   EXEC CICS WEB CONVERSE SESSTOKEN(SESSTOK) PATH('/rates')
             PATHLENGTH(6) METHOD(DFHVALUE(GET)) INTO(REPLY)
             TOLENGTH(REPLYLEN);
   EXEC CICS WEB CLOSE SESSTOKEN(SESSTOK);
   EXEC CICS RETURN;
 END MAIN;
