 /* A sign-on screen's password is compared with the copy kept in a
    Db2 table. */
 SIGNON: PROCEDURE OPTIONS(MAIN);
   DCL 1 SCREEN,
       2 USERID CHAR(8),
       2 PASSWORD CHAR(8);
   DCL STORED_PWD CHAR(8);
   DCL INLEN FIXED BIN(15) INIT(16);
   DCL MSG CHAR(20);
   EXEC SQL INCLUDE SQLCA;

   EXEC CICS RECEIVE INTO(SCREEN) LENGTH(INLEN);
   EXEC SQL SELECT PWD INTO :STORED_PWD FROM USERS WHERE ID = :USERID;
   IF SQLCODE = 0 & STORED_PWD = PASSWORD THEN MSG = 'ACCESS GRANTED';
   ELSE MSG = 'ACCESS DENIED';
   EXEC CICS SEND TEXT FROM(MSG) ERASE;
   EXEC CICS RETURN;
 END SIGNON;
