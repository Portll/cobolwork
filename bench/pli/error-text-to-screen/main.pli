 /* Db2's message text from the SQLCA goes straight to the terminal. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL MSG_LINE CHAR(80);
   EXEC SQL INCLUDE SQLCA;

   EXEC SQL DECLARE C1 CURSOR FOR
            SELECT EMP_ID, EMP_NAME FROM EMPLOYEES WHERE DEPT_ID = 10;
   EXEC SQL OPEN C1;
   IF SQLCODE ^= 0 THEN DO;
     MSG_LINE = SQLERRM;
     EXEC CICS SEND TEXT FROM(MSG_LINE) ERASE;
   END;
   EXEC SQL CLOSE C1;
 END MAIN;
