 /* Terminal input names the CICS file the program reads. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL 1 INAREA,
       2 FILENAME CHAR(8),
       2 RECKEY CHAR(10);
   DCL INLEN FIXED BIN(15) INIT(18);
   DCL FNAME CHAR(8);
   DCL KEY CHAR(10);
   DCL REC CHAR(200);

   EXEC CICS RECEIVE INTO(INAREA) LENGTH(INLEN);
   FNAME = INAREA.FILENAME;
   KEY = INAREA.RECKEY;
   EXEC CICS READ FILE(FNAME) INTO(REC) RIDFLD(KEY);
   EXEC CICS SEND FROM(REC) LENGTH(200);
   EXEC CICS RETURN;
 END MAIN;
