 /* A name typed at the terminal is pasted into a statement the program
    prepares and executes. */
 NAME: PROCEDURE OPTIONS(MAIN);
   DCL 1 INPUT_AREA,
       2 CUST_NAME CHAR(30);
   DCL LEN FIXED BIN(15) INIT(30);
   DCL SQL_TEXT CHAR(200) VARYING;
   EXEC SQL INCLUDE SQLCA;

   EXEC CICS RECEIVE INTO(INPUT_AREA) LENGTH(LEN);
   SQL_TEXT = 'DELETE FROM CUSTOMERS WHERE NAME = '''
              || INPUT_AREA.CUST_NAME || '''';
   EXEC SQL PREPARE STMT FROM :SQL_TEXT;
   IF SQLCODE = 0 THEN EXEC SQL EXECUTE STMT;
   EXEC CICS RETURN;
 END NAME;
