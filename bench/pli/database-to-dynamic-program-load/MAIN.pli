 /* A module name read from a Db2 table is fetched and called. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL REGION CHAR(4) INIT('EAST');
   DCL MODNAME CHAR(8);
   DCL RATECALC ENTRY;
   EXEC SQL INCLUDE SQLCA;

   EXEC SQL SELECT RATE_MODULE INTO :MODNAME
            FROM REGIONS WHERE REGION_ID = :REGION;
   IF SQLCODE ^= 0 THEN RETURN;
   FETCH RATECALC TITLE(MODNAME);
   CALL RATECALC;
 END MAIN;
