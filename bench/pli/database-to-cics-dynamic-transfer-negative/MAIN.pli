 /* The code read from Db2 picks between program names the program
    holds itself. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL ORDTYPE CHAR(2) INIT('RT');
   DCL HANDLER CHAR(1);
   DCL PGMNAME CHAR(8);
   DCL CA CHAR(100);
   EXEC SQL INCLUDE SQLCA;

   EXEC SQL SELECT HANDLER_CODE INTO :HANDLER
            FROM ROUTING WHERE ORDER_TYPE = :ORDTYPE;
   IF SQLCODE ^= 0 THEN DO;
     EXEC CICS RETURN;
   END;
   IF HANDLER = 'W' THEN PGMNAME = 'ORDWHSL';
   ELSE PGMNAME = 'ORDRETL';
   CA = 'NEW ORDER';
   EXEC CICS LINK PROGRAM(PGMNAME) COMMAREA(CA);
   EXEC CICS RETURN;
 END MAIN;
