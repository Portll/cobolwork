 /* The in-stream account number reaches the prepared statement only
    as a parameter marker's value. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL SYSIN FILE RECORD INPUT;
   DCL 1 CARD,
       2 ACCTNO CHAR(10),
       2 FILLER CHAR(70);
   DCL ACCT CHAR(10);
   DCL SQLTXT CHAR(255) VARYING;
   EXEC SQL INCLUDE SQLCA;

   OPEN FILE(SYSIN);
   READ FILE(SYSIN) INTO(CARD);
   CLOSE FILE(SYSIN);
   ACCT = CARD.ACCTNO;
   SQLTXT = 'UPDATE ACCOUNTS SET STATUS = ''C'' WHERE ACCT_NO = ?';
   EXEC SQL PREPARE S1 FROM :SQLTXT;
   IF SQLCODE ^= 0 THEN RETURN;
   EXEC SQL EXECUTE S1 USING :ACCT;
   IF SQLCODE ^= 0 THEN PUT SKIP LIST('EXECUTE FAILED', SQLCODE);
 END MAIN;
