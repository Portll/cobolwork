 /* The in-stream SYSIN card only switches tracing; SUBSTR's start is
    fixed. */
 MAIN: PROCEDURE OPTIONS(MAIN);
   DCL SYSIN FILE RECORD INPUT;
   DCL 1 CARD,
       2 OPTION CHAR(8),
       2 FILLER CHAR(72);
   DCL HEADER CHAR(40) INIT('ACCOUNT STATEMENT FOR PERIOD 2026-09');
   DCL START FIXED BIN(31) INIT(19);
   DCL PART CHAR(10);

   OPEN FILE(SYSIN);
   READ FILE(SYSIN) INTO(CARD);
   CLOSE FILE(SYSIN);
   IF CARD.OPTION = 'TRACE' THEN PUT SKIP LIST('TRACE ON');
   PART = SUBSTR(HEADER, START, 10);
   PUT SKIP LIST('FIELD', PART);
 END MAIN;
